  ],
  "ops": {
    "search": {
      "request": [
        { "name": "list", "url": "{base}/catalog.php?key={keyword|encode}" }
      ],
      "items": "ul.col_3_1 li",
      "where": { "select": "a.ImgA", "attr": "href", "filter": "nonEmpty" },
      "id": { "select": "a.ImgA", "attr": "href", "transform": ["after:/comic/", "before:.html"] },
      "fields": {
        "title": [
          { "select": "a.ImgA", "attr": "title" },
          { "select": "a.txtA" },
          { "select": "img", "attr": "alt" },
          { "default": "{itemId}" }
        ],
        "cover": { "select": "img", "attr": "src" },
        "lastChapter": [
          { "select": "span.info", "filter": "contains:话" },
          { "select": "span.info", "filter": "contains:話" }
        ]
      }
    },
    "category": {
      "request": [{ "name": "list", "url": "{categoryUrl}" }],
      "items": "ul.col_3_1 li",
      "where": { "select": "a.ImgA", "attr": "href", "filter": "nonEmpty" },
      "id": { "select": "a.ImgA", "attr": "href", "transform": ["after:/comic/", "before:.html"] },
      "fields": {
        "title": [
          { "select": "a.ImgA", "attr": "title" },
          { "select": "a.txtA" },
          { "select": "img", "attr": "alt" },
          { "default": "{itemId}" }
        ],
        "cover": { "select": "img", "attr": "src" },
        "lastChapter": [
          { "select": "span.info", "filter": "contains:话" },
          { "select": "span.info", "filter": "contains:話" }
        ]
      }
    },
    "detail": {
      "request": [{ "name": "page", "url": "{base}/comic/{comicId}.html" }],
      "comic": {
        "title": [
          { "select": "h1", "transform": ["stripPrefix:《", "stripSuffix:》"] },
          { "default": "{comicId}" }
        ],
        "cover": { "select": "div#Cover img", "attr": "src" },
        "author": { "select": "p.txtItme", "transform": ["trim"] },
        "intro": { "select": "p.txtDesc", "transform": ["stripPrefix:介绍:"] },
        "status": { "select": "span.date", "contains": "已完结", "then": "finish", "else": "serial" },
        "lastChapter": { "fromChapter": "last" },
        "tags": {
          "array": {
            "at": "a[href^=\"/comics/\"]",
            "take": { "transform": ["trim"] },
            "first": false
          }
        }
      },
      "chapters": {
        "items": "ul[id^=\"mh-chapter-list\"] a[href*=\"/chapter-\"]",
        "index": { "attr": "href", "transform": ["after:chapter-", "before:.html"] },
        "title": { "select": "span" },
        "sort": "asc"
      }
    },
    "images": {
      "request": [
        { "name": "page", "url": "{base}/comic/{comicId}/chapter-{chapterIndex}.html" }
      ],
      "items": {
        "script": "function (api) { var nodes = api.select(api.root, 'img[data-index]'); var seen = {}; var out = []; for (var i = 0; i < nodes.length; i++) { var attrs = nodes[i].attrs || {}; var url = attrs['data-src'] || attrs['src'] || ''; if (!url || seen[url]) continue; seen[url] = true; out.push(nodes[i]); } return out; }"
      },
      "url": [{ "attr": "data-src", "filter": "nonEmpty" }, { "attr": "src" }]
    }
  }
}
